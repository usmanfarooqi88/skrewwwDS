{
  "name": "@skrewww/react",
  "version": "0.1.0-beta.1",
  "description": "Framework-agnostic Skrewww React components (Button, Link, Card, Text Input, Form Field, Validation Message, Spinner, Dialog) with one stylesheet and an optional router provider. Beta preparation.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13.0 <23 || >=24 <25"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  },
  "scripts": {
    "prepublishOnly": "npm --prefix ../.. run prepublish:react-package"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10"
  },
  "keywords": [
    "skrewww",
    "design-system",
    "react",
    "typescript"
  ],
  "homepage": "https://skrewww.com",
  "bugs": {
    "url": "https://github.com/usmanfarooqi88/skrewwwDS/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usmanfarooqi88/skrewwwDS.git",
    "directory": "packages/react"
  }
}
