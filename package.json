{
  "name": "skrewww-docs",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0 <23 || >=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "clean": "rm -rf .next",
    "clean:e2e": "rm -rf .next-playwright",
    "dev:clean": "npm run clean && next dev",
    "build": "npm run generate:registry && npm run generate:agent-context && next build",
    "build:e2e": "npm run clean:e2e && NEXT_DIST_DIR=.next-playwright next build",
    "start": "next start",
    "start:e2e": "NEXT_DIST_DIR=.next-playwright next start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "generate:registry": "tsx scripts/generate-shadcn-registry.ts",
    "generate:agent-context": "tsx scripts/generate-agent-context.ts",
    "generate:agent-eval-prompts": "tsx scripts/generate-agent-eval-prompts.ts",
    "score:agent-eval": "tsx scripts/score-agent-eval.ts",
    "install:agent-skill": "tsx scripts/install-agent-skill.ts",
    "smoke:consumer": "tsx scripts/smoke-test-consumer.ts",
    "verify:package": "node scripts/verify-package-metadata.mjs",
    "verify:node": "node scripts/verify-node-runtime.mjs",
    "verify:analytics": "NODE_OPTIONS=--conditions=react-server tsx scripts/verify-vercel-analytics.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "test:all": "npm run verify:node && npm run verify:package && npm run lint && npm run typecheck && npm test && npm run test:browser && npm run build"
  },
  "dependencies": {
    "@next/third-parties": "^16.3.3",
    "@phosphor-icons/react": "^2.1.10",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "next": "16.2.10",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "recharts": "^3.9.2",
    "server-only": "^0.0.1"
  },
  "overrides": {
    "postcss": "^8.5.10"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.14.15",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.10",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.10",
    "tailwindcss": "^3.4.7",
    "tsx": "^4.23.4",
    "typescript": "^5.5.4",
    "vitest": "^4.1.10"
  }
}
