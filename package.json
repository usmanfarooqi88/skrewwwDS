{
  "name": "skrewww-docs",
  "version": "0.2.0-beta",
  "private": true,
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "next dev",
    "clean": "rm -rf .next",
    "clean:e2e": "rm -rf .next-playwright",
    "dev:clean": "npm run clean && next dev",
    "build": "next build",
    "build:e2e": "npm run clean:e2e && NEXT_DIST_DIR=.next-playwright next build",
    "start": "next start",
    "start:e2e": "NEXT_DIST_DIR=.next-playwright next start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "verify:package": "node scripts/verify-package-metadata.mjs",
    "verify:node": "node scripts/verify-node-runtime.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "test:all": "npm run verify:node && npm run verify:package && npm run lint && npm run typecheck && npm test && npm run test:browser && npm run build"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "next": "14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.14.15",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.40",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.5.4",
    "vitest": "^4.1.10"
  }
}
