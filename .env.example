# Canonical public site URL used for sitemap, registry.json, JSON-LD, Open Graph,
# llms.txt, and canonical metadata. Must be an absolute URL without a trailing slash.
#
# Deployment authority: set this before production builds when the final domain is known.
# Development default when unset: http://localhost:3000
# Production fallback when unset: https://skrewww.dev
#
# skrewww.com is the reserved intended brand domain — not assumed live.
NEXT_PUBLIC_SITE_URL=https://example.com
