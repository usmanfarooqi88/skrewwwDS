# Canonical public site URL used for sitemap, registry.json, JSON-LD, Open Graph,
# llms.txt, and canonical metadata. Must be an absolute URL without a trailing slash.
#
# Deployment authority: set this before production builds when the final domain is known.
# Development default when unset: http://localhost:3000
# Production fallback when unset: https://skrewww.dev
#
# skrewww.com is the reserved intended brand domain — not assumed live.
NEXT_PUBLIC_SITE_URL=https://example.com

# GA4 Measurement ID (app/layout.tsx, via @next/third-parties/google). Public
# by design — a GA Measurement ID is not a secret, it's the same identifier
# gtag.js sends from every visitor's browser. Leave unset in local dev unless
# you're deliberately testing analytics: the tag renders only when this is set.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Server-only — used by lib/server/vercel-analytics.ts. Never prefix these
# with NEXT_PUBLIC_ or reference them from a client component; doing so would
# ship the token to the browser.

# A Vercel access token with read access to this project's Web Analytics.
# Create one at https://vercel.com/account/tokens.
VERCEL_API_TOKEN=

# This project's ID, found in Vercel dashboard > Project > Settings > General.
VERCEL_PROJECT_ID=

# Only required if this Vercel project is owned by a Team, not a personal
# account — check the dashboard's project settings to confirm which applies.
# Found in Vercel dashboard > Team Settings > General. Omit entirely (leave
# unset, not blank) for a personal-account project.
VERCEL_TEAM_ID=
